{
  "name": "slugshift-cli",
  "version": "0.1.0",
  "description": "Convert nginx redirect rewrite rules to JSON or CSV — compatible with Slugshift import semantics.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/slugshift/slugshift-cli.git"
  },
  "keywords": [
    "slugshift",
    "nginx",
    "redirects",
    "cli",
    "csv",
    "json"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "slugshift": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "prepublishOnly": "yarn build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.5"
  }
}
